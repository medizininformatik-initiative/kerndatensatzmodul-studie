# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Interventional study"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "A study in which participants are assigned to receive one or more interventions so that outcomes can be evaluated."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Observational study"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "A study in which biomedical or health outcomes are observed in a defined population without assignment of specific interventions."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Registry study"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "A study primarily based on data collected in a registry (e.g. disease or quality registry)."
msgstr ""

