# ResearchStudy.title
#: ResearchStudy.title
msgid "Frontale transkranielle Gleichstromstimulation (tDCS) als potentielle Behandlungsmethode von Long-COVID bedingter Fatigue"
msgstr ""

# CodeableConcept.text
#: CodeableConcept.text
msgid "Zufallszuteilung"
msgstr ""

# ResearchStudy.description
#: ResearchStudy.description
msgid "Diese Studie untersucht den Einfluss repetitiver anodaler Gleichstromstimulation des linken dorsolateralen präfrontalen Kortex (dlPFC ) auf subjektive und objektive Kennwerte und assoziierte EEG-Parameter der Fatigue bei Long-COVID Patient*innen. Die Studie ist sham-kontrolliert und doppelt-verblindet."
msgstr ""

# ResearchStudy.arm.name
#: ResearchStudy.arm.name
msgid "frontale anodale tDCS  (verum condition)"
msgstr ""

# ResearchStudy.arm.description
#: ResearchStudy.arm.description
msgid "vier Stimulationen, jeweils 30 Minuten, 1.5mA über dem linken dlPFC"
msgstr ""

