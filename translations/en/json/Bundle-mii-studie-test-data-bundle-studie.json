      "target" : null
    },
    {
      "id" : "ResearchStudy.description",
      "context" : "ResearchStudy.description",
      "source" : "Diese Studie untersucht den Einfluss repetitiver anodaler Gleichstromstimulation des linken dorsolateralen präfrontalen Kortex (dlPFC ) auf subjektive und objektive Kennwerte und assoziierte EEG-Parameter der Fatigue bei Long-COVID Patient*innen. Die Studie ist sham-kontrolliert und doppelt-verblindet.",
      "target" : null
    },
    {
      "id" : "ResearchStudy.arm.name",
