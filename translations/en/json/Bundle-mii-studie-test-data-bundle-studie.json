      "id" : "ResearchStudy.title",
      "context" : "ResearchStudy.title",
      "source" : "Frontale transkranielle Gleichstromstimulation (tDCS) als potentielle Behandlungsmethode von Long-COVID bedingter Fatigue",
      "target" : null
    },
    {
      "id" : "CodeableConcept.text",
