    {
      "id" : "ImplementationGuide.definition.resource.name",
      "context" : "ImplementationGuide.definition.resource.name",
      "source" : "Frontale transkranielle Gleichstromstimulation (tDCS) als potentielle Behandlungsmethode von Long-COVID bedingter Fatigue",
      "target" : null
    },
    {
      "id" : "ImplementationGuide.definition.resource.description",
      "context" : "ImplementationGuide.definition.resource.description",
      "source" : "Diese Studie untersucht den Einfluss repetitiver anodaler Gleichstromstimulation des linken dorsolateralen präfrontalen Kortex (dlPFC ) auf subjektive und objektive Kennwerte und assoziierte EEG-Parameter der Fatigue bei Long-COVID Patient*innen. Die Studie ist sham-kontrolliert und doppelt-verblindet.",
      "target" : null
    },
