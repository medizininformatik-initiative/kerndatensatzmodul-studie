      <trans-unit id="CodeSystem-associated-party-role-cs" resname="CodeSystem.concept.definition">
             <notes>
               <note id="n1">CodeSystem.concept.definition</note>
             </notes>
        <source>An individual or organization that takes responsibility for the initiation, management, and financing of a study.</source>
        <target></target>
      </trans-unit>
