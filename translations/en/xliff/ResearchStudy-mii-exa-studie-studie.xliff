      <trans-unit id="ResearchStudy-mii-exa-studie-studie" resname="ResearchStudy.title">
             <notes>
               <note id="n1">ResearchStudy.title</note>
             </notes>
        <source>Frontale transkranielle Gleichstromstimulation (tDCS) als potentielle Behandlungsmethode von Long-COVID bedingter Fatigue</source>
        <target></target>
      </trans-unit>
      <trans-unit id="ResearchStudy-mii-exa-studie-studie" resname="CodeableConcept.text">
             <notes>
               <note id="n1">CodeableConcept.text</note>
             </notes>
        <source>Zufallszuteilung</source>
        <target></target>
      </trans-unit>
      <trans-unit id="ResearchStudy-mii-exa-studie-studie" resname="ResearchStudy.description">
             <notes>
               <note id="n1">ResearchStudy.description</note>
             </notes>
        <source>Diese Studie untersucht den Einfluss repetitiver anodaler Gleichstromstimulation des linken dorsolateralen präfrontalen Kortex (dlPFC ) auf subjektive und objektive Kennwerte und assoziierte EEG-Parameter der Fatigue bei Long-COVID Patient*innen. Die Studie ist sham-kontrolliert und doppelt-verblindet.</source>
        <target></target>
      </trans-unit>
      <trans-unit id="ResearchStudy-mii-exa-studie-studie" resname="ResearchStudy.arm.name">
             <notes>
               <note id="n1">ResearchStudy.arm.name</note>
             </notes>
        <source>frontale anodale tDCS  (verum condition)</source>
        <target></target>
      </trans-unit>
      <trans-unit id="ResearchStudy-mii-exa-studie-studie" resname="ResearchStudy.arm.description">
             <notes>
               <note id="n1">ResearchStudy.arm.description</note>
             </notes>
        <source>vier Stimulationen, jeweils 30 Minuten, 1.5mA über dem linken dlPFC</source>
        <target></target>
      </trans-unit>
      <trans-unit id="ResearchStudy-mii-exa-studie-studie" resname="ResearchStudy.arm.name">
             <notes>
               <note id="n1">ResearchStudy.arm.name</note>
             </notes>
        <source>frontale sham tDCS</source>
        <target></target>
      </trans-unit>
