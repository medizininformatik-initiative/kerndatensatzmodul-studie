       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Das vorliegende CapabilityStatement beschreibt alle verpflichtenden Interaktionen die ein konformes System unterstützen muss um das Modul Studie der Medizininformatik Initiative zu implementieren." ] ;
