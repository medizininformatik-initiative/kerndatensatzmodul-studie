       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://www.medizininformatik-initiative.de/fhir/modul-studie/ResearchStudy/mii-exa-studie-studie> ;
         fhir:Reference.reference [ fhir:value "ResearchStudy/mii-exa-studie-studie" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Frontale transkranielle Gleichstromstimulation (tDCS) als potentielle Behandlungsmethode von Long-COVID bedingter Fatigue" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Diese Studie untersucht den Einfluss repetitiver anodaler Gleichstromstimulation des linken dorsolateralen präfrontalen Kortex (dlPFC ) auf subjektive und objektive Kennwerte und assoziierte EEG-Parameter der Fatigue bei Long-COVID Patient*innen. Die Studie ist sham-kontrolliert und doppelt-verblindet." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
         fhir:value "https://www.medizininformatik-initiative.de/fhir/modul-studie/StructureDefinition/mii-pr-studie-studie" ;
         fhir:link <https://www.medizininformatik-initiative.de/fhir/modul-studie/StructureDefinition/mii-pr-studie-studie>
       ]
